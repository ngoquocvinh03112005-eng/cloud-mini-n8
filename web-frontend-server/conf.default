server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location = /nginx_status {
        stub_status;
        access_log off;
        allow 172.18.0.0/16;
        deny all;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location ^~ /blog/ {
        alias /usr/share/nginx/html/blog/;
        index index.html;
        autoindex off;
    }
}