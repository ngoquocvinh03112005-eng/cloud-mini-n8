# Public URL used by Keycloak and backend token validation
# Local: http://localhost:8081
# EC2: http://YOUR_EC2_PUBLIC_IP:8081
PUBLIC_BASE_URL=http://localhost:8081

# MariaDB
DB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD
MARIADB_ROOT_PASSWORD=CHANGE_ME_MARIADB_ROOT_PASSWORD

# Keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD

# Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
